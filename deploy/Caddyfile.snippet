# HM-11: append to /etc/caddy/Caddyfile on the server, replacing both placeholders.
# Generate the hash with the deploy wizard (scripts/deploy-wizard.sh) — never commit a real hash.
<TAXLENS_DOMAIN> {
	# Access log for fail2ban (jail caddy-basic-auth, deploy/fail2ban/). Caddy redacts the
	# Authorization header. Create the file owned by caddy BEFORE `caddy validate` — validating
	# as root creates it root-owned and the reload then fails (see docs/HOSTING.md → fail2ban).
	log {
		output file /var/log/caddy/taxlens-access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}

	encode zstd gzip

	basic_auth {
		<USERNAME> <BCRYPT_HASH>
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Caddy forwards the client's Host header unchanged, which the HM-8 Origin check relies on.
	reverse_proxy 127.0.0.1:3005
}
